{
  "family": "bad-streams",
  "version": 1,
  "description": "Bad stream marks (hard: two days by source id and by the full multi-line release name; soft: two hours by source id only; read back as soft once under two hours remain) and failover planning.",
  "cases": [
    {
      "name": "never marked",
      "fn": "badKind",
      "input": {
        "ops": [],
        "query": {
          "itemId": "ep1",
          "source": {
            "id": "a",
            "name": "Torrentio 1080p\nShow.S01E01.1080p.WEB.mkv"
          },
          "atMs": 0
        }
      },
      "expected": null
    },
    {
      "name": "hard mark",
      "fn": "badKind",
      "input": {
        "ops": [
          {
            "op": "mark",
            "itemId": "ep1",
            "source": {
              "id": "a",
              "name": "Torrentio 1080p\nShow.S01E01.1080p.WEB.mkv"
            },
            "soft": false,
            "atMs": 0
          }
        ],
        "query": {
          "itemId": "ep1",
          "source": {
            "id": "a",
            "name": "Torrentio 1080p\nShow.S01E01.1080p.WEB.mkv"
          },
          "atMs": 3600000
        }
      },
      "expected": "hard"
    },
